<?xml version="1.0" encoding="utf-8"?>
<!-- Panel sadece ev ağı ve Tailscale üzerinden düz HTTP ile çalışır (Tailscale bağlantıyı zaten şifreler). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.12</domain>
        <domain includeSubdomains="false">100.113.200.36</domain>
    </domain-config>
</network-security-config>
