<?xml version="1.0" encoding="utf-8"?>
<!--
    Finansal veriler buluta (Google Drive yedeği) GÖNDERİLMEZ.
    Yalnızca kablo/yerel cihazdan cihaza aktarıma (ör. Samsung Smart Switch) izin verilir.
    Elle yedek için uygulamadaki "Dışa aktar" özelliği kullanılabilir.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="file" />
    </device-transfer>
</data-extraction-rules>
